{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caelestis.cam/ns/document-provenance/1.0/schema.json",
  "title": "Caelestis Document Provenance 1.0",
  "description": "Current document-level provenance state. Amendment history remains in the document Amendment Ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "subject", "authorshipState", "entities", "provenanceRecord"],
  "properties": {
    "profile": {"const": "Caelestis-Document-Provenance-1.0"},
    "subject": {"$ref": "#/$defs/subject"},
    "authorshipState": {
      "enum": [
        "AUTH.HUMAN_AUTHORED",
        "AUTH.AI_SYSTEM_AUTHORED",
        "AUTH.CO_AUTHORED",
        "AUTH.OTHER_AUTHORSHIP",
        "AUTH.UNDETERMINED"
      ]
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity"}
    },
    "authoringParties": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entityRef"}
    },
    "formationReferences": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/formationReference"}
    },
    "agentIdentityStatements": {
      "type": "array",
      "items": {"$ref": "#/$defs/agentIdentityStatement"}
    },
    "contributions": {
      "type": "array",
      "items": {"$ref": "#/$defs/contribution"}
    },
    "humanReviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entityRef"}
    },
    "editorialResponsibility": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entityRef"}
    },
    "adoptionAuthority": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entityRef"}
    },
    "publicationAuthority": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entityRef"}
    },
    "technicalProvenance": {"$ref": "#/$defs/technicalProvenance"},
    "transformations": {
      "type": "array",
      "items": {"$ref": "#/$defs/transformation"}
    },
    "provenanceRecord": {"type": "string", "minLength": 1},
    "rights": {"$ref": "#/$defs/rights"},
    "evidenceNote": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"authorshipState": {"not": {"const": "AUTH.UNDETERMINED"}}},
        "required": ["authorshipState"]
      },
      "then": {"required": ["authoringParties"]}
    },
    {
      "if": {
        "properties": {
          "technicalProvenance": {
            "properties": {
              "status": {
                "enum": [
                  "TPROV.LOST_DURING_TRANSFORMATION",
                  "TPROV.STRIPPED_BY_DESIGN"
                ]
              }
            },
            "required": ["status"]
          }
        },
        "required": ["technicalProvenance"]
      },
      "then": {
        "properties": {
          "technicalProvenance": {
            "required": ["statusDetail", "transformationEvents"]
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"},
    "entityRef": {"$ref": "#/$defs/identifier"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "type": {"enum": ["document", "dataset", "repository", "collection", "other"]}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "entityType"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "citationName": {
          "type": "string",
          "pattern": "^\\S(?:.*\\S)?$",
          "description": "Optional stable bibliographic or public representation of this entity. It does not create another entity, change authorship classification, establish legal identity, or substitute for name, identifier or formation provenance."
        },
        "entityType": {
          "enum": ["human", "agent_identity", "ai_system", "organization", "automated_process", "other", "unknown"]
        },
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "identifier": {"type": "string", "minLength": 1}
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "roles"],
      "properties": {
        "actor": {"$ref": "#/$defs/entityRef"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONTRIB.SUBSTANTIVE_DRAFTING",
              "CONTRIB.SUBSTANTIVE_REVISION",
              "CONTRIB.SYNTHESIS",
              "CONTRIB.TRANSLATION",
              "CONTRIB.SUMMARISATION",
              "CONTRIB.STANDARD_EDITING",
              "CONTRIB.FORMATTING",
              "CONTRIB.REVIEW",
              "CONTRIB.RETRIEVAL",
              "CONTRIB.CLASSIFICATION",
              "CONTRIB.OTHER_TRANSFORMATION"
            ]
          }
        },
        "description": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "formationReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "formationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authoringParty", "runtimeSnapshot", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "authoringParty": {"$ref": "#/$defs/entityRef"},
        "runtimeSnapshot": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/formationEvidence"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "formationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "basis"],
      "properties": {
        "state": {"enum": ["declared", "observed", "verified", "unknown"]},
        "basis": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "agentIdentityStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "statement", "continuityLimit", "adaptationBasis", "modelLineage"],
      "properties": {
        "identity": {"$ref": "#/$defs/entityRef"},
        "statement": {"type": "string", "minLength": 1},
        "continuityLimit": {"type": "string", "minLength": 1},
        "adaptationBasis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["term", "description", "evidence"],
          "properties": {
            "term": {"const": "persistent behavioural configuration"},
            "description": {"type": "string", "minLength": 1},
            "evidence": {"$ref": "#/$defs/formationEvidence"}
          }
        },
        "modelLineage": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/modelLineageEntry"}
        }
      }
    },
    "modelLineageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designation", "precision", "evidence"],
      "properties": {
        "designation": {"type": "string", "minLength": 1},
        "precision": {"enum": ["family", "exact", "unknown"]},
        "evidence": {"$ref": "#/$defs/formationEvidence"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "technicalProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "TPROV.PRESENT",
            "TPROV.ABSENT",
            "TPROV.PROVIDER_MANAGED",
            "TPROV.LOST_DURING_TRANSFORMATION",
            "TPROV.STRIPPED_BY_DESIGN",
            "TPROV.UNSUPPORTED",
            "TPROV.UNKNOWN"
          ]
        },
        "anchors": {
          "type": "array",
          "items": {"$ref": "#/$defs/anchor"}
        },
        "statusDetail": {"type": "string", "minLength": 1},
        "transformationEvents": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": {
          "enum": ["version_control", "amendment_ledger", "content_credential", "provider_record", "signature", "hash", "other"]
        },
        "reference": {"type": "string", "minLength": 1},
        "status": {"enum": ["available", "provider_managed", "unavailable", "unknown"]}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "actor"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "actor": {"$ref": "#/$defs/entityRef"},
        "source": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "meaningPreserved": {"type": ["boolean", "null"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "copyrightHolders": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/entityRef"}
        },
        "licenseReference": {"type": "string", "minLength": 1}
      }
    }
  }
}
